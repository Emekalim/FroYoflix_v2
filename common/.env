# FroYo Environment Configuration
# Phase 2: TMDB & Trakt Integration

# ============================================================================
# TMDB (The Movie Database) Configuration
# ============================================================================
# Get your API key at: https://www.themoviedb.org/settings/api
# 
# Steps:
# 1. Go to https://www.themoviedb.org/settings/api
# 2. Request an API key (free tier available)
# 3. Verify your email
# 4. Copy your API key below
#
TMDB_API_KEY=cdf80faab76783a9d40917063ef6b921

# ============================================================================
# Trakt Configuration
# ============================================================================
# Get your credentials at: https://trakt.tv/oauth/authorize
#
# Client ID:
# 1. Go to https://trakt.tv/settings/applications
# 2. Create a new OAuth application
# 3. Copy the Client ID below
#
# Access Token (Optional - for user-specific data):
# 1. Authorize your app at: https://trakt.tv/oauth/authorize
# 2. Copy the access token below (only needed for user data sync)
#
TRAKT_CLIENT_ID=775d293675799ca64aff13a8505fd2b0d296c94e31f270a479aa0b1d1933fe3c
TRAKT_ACCESS_TOKEN=your_trakt_access_token_here

# ============================================================================
# Environment
# ============================================================================
# Set to 'development' or 'production'
NODE_ENV=development
